# Copy to .env next to docker-compose.yml and set real values.
# .env is listed in .gitignore and must never be committed.

# InfluxDB initial admin password and API token (used by the logger as INFLUXtoken)
DOCKER_INFLUXDB_INIT_PASSWORD=change-me
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=change-me

# Grafana admin password
GF_SECURITY_ADMIN_PASSWORD=change-me
