        "query": "import \"array\"\nimport \"date\"\nimport \"timezone\"\noption location = timezone.location(name: \"Europe/Zurich\")\nz = date.add(d: 12h, to: date.add(d: 1y, to: date.truncate(t: time(v: \"${jahr}-06-15T12:00:00Z\"), unit: 1y)))\narray.from(rows: [{_value: string(v: date.year(t: z))}])",
        "definition": "import \"array\"\nimport \"date\"\nimport \"timezone\"\noption location = timezone.location(name: \"Europe/Zurich\")\nz = date.add(d: 12h, to: date.add(d: 1y, to: date.truncate(t: time(v: \"${jahr}-06-15T12:00:00Z\"), unit: 1y)))\narray.from(rows: [{_value: string(v: date.year(t: z))}])",
