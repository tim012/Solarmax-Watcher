        "sort": 0,
        "regex": "",
        "current": {},
        "options": [],
        "hide": 2,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "heute_jahr",
        "label": "heute_jahr",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "${ds}"
        },
        "query": "import \"array\"\nimport \"date\"\nimport \"timezone\"\noption location = timezone.location(name: \"Europe/Zurich\")\nfrom(bucket: \"solarmax\")\n  |> range(start: -90d)\n  |> group()\n  |> max(column: \"_time\")\n  |> keep(columns: [\"_time\"])\n  |> map(fn: (r) => ({_value: string(v: date.year(t: r._time))}))",
        "definition": "import \"array\"\nimport \"date\"\nimport \"timezone\"\noption location = timezone.location(name: \"Europe/Zurich\")\nfrom(bucket: \"solarmax\")\n  |> range(start: -90d)\n  |> group()\n  |> max(column: \"_time\")\n  |> keep(columns: [\"_time\"])\n  |> map(fn: (r) => ({_value: string(v: date.year(t: r._time))}))",
        "refresh": 1,
        "sort": 0,
        "regex": "",
        "current": {},
        "options": [],
        "hide": 2,
        "multi": false,
        "includeAll": false
      }
